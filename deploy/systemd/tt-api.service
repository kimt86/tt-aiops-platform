[Unit]
Description=TT AiOps Platform API (axum) — serves web/dist + reads Postgres + live-map GPS ingest
After=network-online.target wp-ws-bridge.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/projects/tt-aiops-platform
Environment=DATABASE_URL=postgresql://wp:wp@127.0.0.1:5433/wp_tt
Environment=API_ADDR=0.0.0.0:8080
Environment=RUST_LOG=info,tt_api=info
# Stage-2 선택에 '출항 역산 마감 티어'를 반영한다(그림자 한정·실배차 무영향).
# 끄려면 이 줄을 지우거나 0으로: 티어는 계산·기록은 계속하되 정렬에는 안 쓰인다
# (stable sort라 OFF는 종전과 동일한 순서를 언어 보장 수준으로 재현). 값은
# spawn_stage2_shadow 시작 시 1회만 읽으므로 변경에는 재시작이 필요하다.
Environment=STAGE2_DEP_TIER=1
ExecStart=%h/projects/tt-aiops-platform/target/release/api
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
