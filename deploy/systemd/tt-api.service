[Unit]
Description=TT AiOps Platform API (axum) — serves web/dist + reads Postgres + live-map GPS ingest
After=network-online.target wp-ws-bridge.service
Wants=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 실측 최고치 144M 대비 넉넉하다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=4G
MemorySwapMax=0
WorkingDirectory=%h/projects/tt-aiops-platform
Environment=DATABASE_URL=postgresql://wp:wp@127.0.0.1:5433/wp_tt
Environment=API_ADDR=0.0.0.0:8080
Environment=RUST_LOG=info,tt_api=info
# Stage-2 선택에 '출항 역산 마감 티어'를 반영한다(그림자 한정·실배차 무영향).
#   (미설정) = 항상 OFF · 1 = 항상 ON · ab = A/B 측정(30분 블록 무작위)
#
# ★2026-08-02 A/B 판정 완료 → **채택(=1)**. 07-31~08-02 이틀간 30분 블록 무작위 배정
# (OFF 47블록 / ON 49블록 · 틱 1,269 / 1,319). 판정 근거:
#   · 작동 원리: 이미 마감을 넘긴 버킷 서빙이 틱당 2.26 → 9.89 (4.4배, t=8.63) — 압도적
#   · 효율 대가: 배정당 빈 차 이동 368 → 369초 (+1.5초, t=0.25) — 사실상 0
#   · 결과: 마감초과율 10.5% → 8.0%. 부하(트럭당 작업량) 3층 보정 후 **−2.63%p (t=−3.18)**
#     그리고 한산 −0.93 / 보통 −2.79 / 혼잡 −4.22%p 로 **혼잡할수록 효과가 커진다** —
#     트럭이 모자랄 때만 "무엇을 먼저 담느냐"가 의미를 갖는다는 이치와 맞는다.
# ⚠ 정직한 단서 둘: ①사전 등록한 1차 지표(마감미스/틱)는 t=1.65 로 기준 미달이었고 유의성은
#   검정력이 높은 비율 지표 + 층화 보정에서 나왔다(사후 분석). ②재배정률 26.3→29.1%(t=1.45)는
#   미확인 비용이다. 근거·재현은 scripts/ab_report.sql.
# ⚠ 무작위 배정에 우연한 쏠림이 있었다(ON 쪽 트럭 66.5 vs 60.9·작업 228 vs 201, 둘 다 t≈2).
#   보정이 필요했던 이유이고, 쏠림 방향은 ON 에 불리했다(트럭당 작업 3.42 vs 3.30).
#
# 재판정이 필요하면 `ab` 로 되돌리면 된다(ab_block 컬럼과 리포트가 그대로 있다).
# 값은 spawn_stage2_shadow 시작 시 1회만 읽으므로 변경에는 재시작이 필요하다.
Environment=STAGE2_DEP_TIER=1
# mig0119: 지평 레버 A/B. 판정 끝나면 1(채택) 또는 제거(기각).
Environment=STAGE2_NEED_HORIZON=0
ExecStart=%h/projects/tt-aiops-platform/target/release/api
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
