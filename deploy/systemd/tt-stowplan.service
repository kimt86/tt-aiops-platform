[Unit]
Description=tt-aiops-platform 적부계획 상자 순번 스냅샷 (VSP_SHIP -> live_stow_plan). 구역 안 작업 순서의 권위 값.
After=network-online.target
# 실패하면 ops_alert 에 남긴다 — oneshot 이라 재시도가 없어 조용히 결손된다.
OnFailure=tt-unit-failed@%n.service

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 한 주기 페이로드가 ~0.5MB 라 넉넉하다.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
# 멈춘 실행이 끝나지 않으면 타이머가 다음 회차를 건너뛰고 실패 경보도 안 뜬다 — 넘기면 실패로 끊어 OnFailure 가
# 울리게 한다(2026-10-08·tt-tos-avail 선례). 실측 소요 p99 2.4·max 14.3초.
TimeoutStartSec=180
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/extractor stowplan --target oracle-prod
Nice=15
