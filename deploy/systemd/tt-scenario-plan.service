[Unit]
Description=wp-tt scenario quay-crane work-plan archiver (ISOLATED, non-critical): live_workqueue -> scenario.qc_plan, row-level revisions until the call berths. Reads only our own tables — ZERO Oracle. Fault here never affects dispatch/dashboard extraction.
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 이 유닛은 Oracle을 안 쓰고 로컬 표만 읽는다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=2G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/scengen qc-plan
Nice=19
