[Unit]
Description=wp-tt scenario monitor/control web (ISOLATED, non-critical). Own port; reads scenario.* + enqueues jobs / kill switch. Never mounted on the dashboard API.
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지).
# ⚠ 처음에 "실측 최고치 14M" 으로 보고 1G 를 걸었는데 그건 재부팅 40분 시점 값이었다.
# warm 상태 실측은 559M — 40배다. 이건 배치가 아니라 야드 상태를 메모리에 들고
# 상주하는 서버(scengen serve :8899)라 시간이 지나며 커진다. 1G 는 여유 1.8배로
# 하드닝이 오히려 이 서비스를 OOM 킬 할 수 있었다. 559M 대비 7배로 잡는다.
# 배치 유닛들(실측 4~21M)과 값이 다른 이유가 이것이다.
MemoryMax=4G
MemorySwapMax=0
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/scengen serve --port 8899
Restart=on-failure
RestartSec=5
Nice=15

[Install]
WantedBy=default.target
