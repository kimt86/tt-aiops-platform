[Unit]
Description=tt-aiops-platform nightly authoritative KPI extract (yesterday, all KPIs)
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 실측 최고치 미측정 대비 넉넉하다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=4G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
# runs all 8 extracts for yesterday + transform (final) + baseline
ExecStart=%h/projects/tt-aiops-platform/target/release/extractor run --kpi all --target oracle-prod
Nice=10
