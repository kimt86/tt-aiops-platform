[Unit]
Description=tt-aiops-platform refresh learn_cycle_remaining (candidate-vehicle pickup->free time predictor; Postgres-only, no Oracle)
After=network-online.target
# 실패하면 ops_alert 에 남긴다 — oneshot 이라 재시도가 없어 조용히 결손된다.
OnFailure=tt-unit-failed@%n.service

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 실측 최고치 4M 대비 넉넉하다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
# Re-aggregate a 14-day rolling window of tt_move_log trips into the (jobtype, n_containers)
# median/p90 pickup->free time. Full-population label (GPS-independent), so unbiased for the
# GPS-silent trucks the move-log selector catches. Slow-moving → 30-min refresh is ample.
ExecStart=/usr/bin/psql "${DATABASE_URL}" -v days=14 -f %h/projects/tt-aiops-platform/scripts/populate_learn_cycle_remaining.sql
Nice=15
