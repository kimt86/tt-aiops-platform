# GPS 웹소켓 SSH 터널 — 위치 파이프라인 전체의 단일 장애점.
#
# 왜 .example 인가: 실제 유닛에는 내부망 주소(경유 호스트·최종 목적지·계정)가 박혀 있는데,
# 이 저장소에는 GitHub 원격이 있어 그대로 커밋하면 내부 망 구성이 밖으로 나간다. 값은
# .env(gitignore 대상)에 두고 systemd 가 ExecStart 에서 치환하게 했다.
#
# 설치:
#   1) .env 에 두 줄 추가
#        WS_BRIDGE_FORWARD=127.0.0.1:9986:<최종 GPS 호스트>:9986
#        WS_BRIDGE_TARGET=<계정>@<경유 호스트>
#      (현재 운영 중인 값은 호스트의 ~/.config/systemd/user/wp-ws-bridge.service 에 있다)
#   2) cp wp-ws-bridge.service.example ~/.config/systemd/user/wp-ws-bridge.service
#   3) systemctl --user daemon-reload && systemctl --user enable --now wp-ws-bridge
#
# ⚠ 이 터널이 끊기면 라이브맵의 트럭 좌표가 통째로 멈춘다. 배차 매칭은 GPS 미연결 틱을
#   건너뛰므로 추천도 함께 선다(의도된 동작).

[Unit]
Description=WP-TT GPS websocket SSH tunnel (127.0.0.1:9986 -> 경유 호스트 -> GPS 호스트)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). ssh 터널이라 실사용 ~10M.
MemoryMax=256M
MemorySwapMax=0
EnvironmentFile=%h/projects/tt-aiops-platform/.env
# BatchMode=yes 로 프롬프트에서 멈추지 않고 바로 실패하게 하고, ExitOnForwardFailure 로
# 포트가 겹치면 반쯤 뜬 채로 도는 대신 종료해 Restart= 가 다시 잡게 한다.
ExecStart=/usr/bin/ssh -N \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -o ServerAliveInterval=20 \
  -o ServerAliveCountMax=3 \
  -L ${WS_BRIDGE_FORWARD} \
  ${WS_BRIDGE_TARGET}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
