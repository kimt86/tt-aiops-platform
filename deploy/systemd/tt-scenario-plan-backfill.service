[Unit]
Description=wp-tt scenario quay-crane plan BACKFILL (ISOLATED, non-critical): recover JOB_QUEUE_SCHEDULE per (vessel,voyage) for calls the live archiver missed. One batched index-seek round trip per tick; goes quiet by itself once drained. Fault here never affects dispatch/dashboard extraction.
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지).
MemoryMax=2G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/scengen plan-backfill --target oracle-prod
Nice=19
