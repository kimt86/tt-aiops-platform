[Unit]
Description=wp-tt scenario assembly worker (ISOLATED, non-critical): build queued scenario/emulator windows out of process -> scenario.assembly_job. LOCAL ONLY, zero Oracle. Fault here never affects dispatch/dashboard extraction.
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 다른 유닛보다 큰 이유:
# 이 워커만이 창 전체를 메모리에 펼친다. **실측(하루 창): 최대 RSS 531MB · 23.5초.**
# 대략 창 길이에 비례하므로 4G 는 5~6일치가 현실적 한계이고, API 상한 7일은 그 위다.
# 넘치면 커널이 이 프로세스만 죽이고, 다음 틱이 그 job 을 error 로 마감한다(자동 재시도 없음 —
# 워커를 죽인 job 을 되돌려 넣으면 죽이는 일만 반복한다).
# 저장 비용은 걱정보다 작았다: 하루 창 산출물 23.4MB 가 jsonb+TOAST 압축으로 **3.4MB**.
MemoryMax=4G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/scengen assemble
# 동기 다운로드와 달리 급할 이유가 없다. 배차/대시보드가 쓰는 CPU 를 뺏지 않도록 최하위.
Nice=19
IOSchedulingClass=idle
