# TOS ETW 게이트웨이 SSH 터널 — 추출기가 컨테이너별 ETW 를 받는 경로.
#
# ★★ 불가침: 이 터널이 닿는 Azure `tos_etw_gateway` 는 **다른 시스템도 함께 쓴다**(2026-08-05
#    사용자 지시). 주기·질의·중단을 우리 판단으로 바꾸지 않는다. 이 파일은 재해복구용 기록일
#    뿐이며, 돌고 있는 터널을 이걸로 덮어쓸 이유는 없다.
#    ⚠ ETW 호출은 Oracle 부하가 아니다(Azure HTTP) — Oracle 부하표에 같이 놓지 말 것.
#
# 왜 .example 인가: 실제 유닛에 내부망 주소가 박혀 있고 이 저장소에는 GitHub 원격이 있다.
# 값은 .env(gitignore 대상)에 둔다.
#
# 설치:
#   1) .env 에 두 줄 추가
#        ETW_BRIDGE_FORWARD=127.0.0.1:18080:127.0.0.1:18080
#        ETW_BRIDGE_TARGET=<계정>@<경유 호스트>
#      (현재 운영 중인 값은 호스트의 ~/.config/systemd/user/wp-etw-bridge.service 에 있다)
#   2) cp wp-etw-bridge.service.example ~/.config/systemd/user/wp-etw-bridge.service
#   3) systemctl --user daemon-reload && systemctl --user enable --now wp-etw-bridge
#
# 끊겼을 때: 추출기는 warn 로그만 남기고 조용히 건너뛴다(실패해도 멈추지 않는다).
# 즉 ETW 가 비어도 티가 잘 안 나므로, 마감 정밀도가 조용히 나빠지는 형태로 나타난다.

[Unit]
Description=TOS ETW gateway SSH tunnel (127.0.0.1:18080 -> 경유 호스트 -> 게이트웨이)
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). ssh 터널이라 실사용 ~10M.
MemoryMax=256M
MemorySwapMax=0
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=/usr/bin/ssh -N \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -o ServerAliveInterval=20 \
  -o ServerAliveCountMax=3 \
  -L ${ETW_BRIDGE_FORWARD} \
  ${ETW_BRIDGE_TARGET}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
