[Unit]
Description=배차 마감 두 축 비교 리포트 (mig0120) — 옛 축 vs 설계 ②, 1회성
# 왜 로컬 타이머인가: 이 비교는 127.0.0.1:5433 의 운영 Postgres 를 읽는다. 클라우드에서 도는
# 예약 에이전트는 이 DB 에 닿을 수 없으므로 여기서 돌린다.
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지 규율). 읽기 전용 리포트라 여유는 충분하다.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
WorkingDirectory=%h/projects/tt-aiops-platform
Environment=PGPASSWORD=wp
# SELECT 전용 스크립트. 결과는 파일로 남긴다 — 타이머가 판정까지 하지는 않는다.
ExecStart=/bin/sh -c 'mkdir -p %h/projects/tt-aiops-platform/data/reports && \
  psql -h 127.0.0.1 -p 5433 -U wp -d wp_tt \
       -f %h/projects/tt-aiops-platform/scripts/deadline_axis_compare.sql \
  > %h/projects/tt-aiops-platform/data/reports/deadline_axis_$(date +%%Y%%m%%d_%%H%%M).txt 2>&1'
Nice=10
