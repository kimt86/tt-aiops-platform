[Unit]
Description=tt-aiops-platform 적부계획 델타 화해(reconcile) — 전체 스냅샷으로 드리프트 점검+치유 (PLAN-extractor CHUNK3)
After=network-online.target
# 실패하면 ops_alert 에 남긴다 — oneshot 이라 재시도가 없어 조용히 결손된다.
OnFailure=tt-unit-failed@%n.service

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). tt-stowplan.service 와 같은 상한.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
# 멈춘 실행이 끝나지 않으면 타이머가 다음 회차를 건너뛰고 실패 경보도 안 뜬다 — 넘기면 실패로 끊어 OnFailure 가
# 울리게 한다(2026-10-08·tt-tos-avail 선례). 실측 소요 max 8.6초.
TimeoutStartSec=900
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/extractor stowplan --target oracle-prod --reconcile
Nice=15
