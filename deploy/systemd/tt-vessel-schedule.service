[Unit]
Description=tt-aiops-platform 선박 스케줄 스냅샷 (VSB_VOYAGE -> live_vessel_schedule). workpool 틱에서 분리(PLAN-extractor CHUNK5 5-3, 228행뿐이라 델타화 이득 없음)
After=network-online.target
# 실패하면 ops_alert 에 남긴다 — oneshot 이라 재시도가 없어 조용히 결손된다.
OnFailure=tt-unit-failed@%n.service

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 소량(수십행) 조회라 넉넉하다.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/extractor vessel-schedule --target oracle-prod
Nice=15
