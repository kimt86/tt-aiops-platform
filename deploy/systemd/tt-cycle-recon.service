[Unit]
Description=tt-aiops-platform refresh tt_cycle_recon (attach GPS move/stop split to tt_move_log cycles; Postgres-only, no Oracle)
After=network-online.target
# 실패하면 ops_alert 에 남긴다 — oneshot 이라 재시도가 없어 조용히 결손된다.
OnFailure=tt-unit-failed@%n.service

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 실측 최고치 4M 대비 넉넉하다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
# Re-scan a 2-day window and insert (ON CONFLICT DO NOTHING) so each cycle is computed once while its
# raw fixes are still in truck_pos_hifreq (~1-day retention). Depends on tt_move_log (cycle boundaries)
# + truck_pos_hifreq (positions) being fresh → runs offset after the move-log refresh.
ExecStart=/usr/bin/psql "${DATABASE_URL}" -v days=2 -f %h/projects/tt-aiops-platform/scripts/populate_tt_cycle_recon.sql
Nice=15
