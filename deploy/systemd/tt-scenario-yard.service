[Unit]
Description=wp-tt scenario yard-crane move stream (ISOLATED, non-critical, LOCAL only): public.rtg_move_log rows + decoded stack position -> scenario.yard_move. ZERO Oracle since 2026-08-06. Fault here never affects dispatch/dashboard extraction.
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 실측 최고치 18M 대비 넉넉하다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=2G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=%h/projects/tt-aiops-platform/target/release/scengen yard-moves --target oracle-prod
Nice=19
