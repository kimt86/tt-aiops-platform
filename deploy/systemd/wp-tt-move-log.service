[Unit]
Description=tt-aiops-platform refresh tt_move_log (join tos_handover_label + qc_move_log; Postgres-only, no Oracle)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
# Re-scan a 2-day window and upsert (ON CONFLICT DO NOTHING) so both twin legs and late-arriving
# handovers land. Depends on qc_move_log / tos_handover_label being fresh → runs offset after those.
ExecStart=/usr/bin/psql "${DATABASE_URL}" -v days=2 -f %h/projects/tt-aiops-platform/scripts/populate_tt_move_log.sql
Nice=15
