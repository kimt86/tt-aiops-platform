[Unit]
Description=tt-aiops-platform cycle_pred_shadow (candidate completion-time predictor SHADOW; log prediction at pickup, backfill actual free; Postgres-only, no Oracle, no dispatch impact)
After=network-online.target

[Service]
# 폭발 반경 제한(2026-07-28 OOM 장애 재발방지). 실측 최고치 4M 대비 넉넉하다.
# 초과 시 커널이 서버가 아니라 이 유닛만 죽인다.
MemoryMax=1G
MemorySwapMax=0
Type=oneshot
EnvironmentFile=%h/projects/tt-aiops-platform/.env
ExecStart=/usr/bin/psql "${DATABASE_URL}" -v mins=90 -f %h/projects/tt-aiops-platform/scripts/populate_cycle_pred_shadow.sql
Nice=15
