[Unit]
Description=wp-tt LIVE work-pool snapshot every 60s (one merged pool_tick pull; CHUNK8)

[Timer]
OnBootSec=1min
# :55 — clear of the 60s move triad (:05/:25/:45), vessel-schedule (:35),
# stowplan (:15 even minutes — the first pick collided there) and scengen (:10-:50).
OnCalendar=*-*-* *:*:55
AccuracySec=1s

[Install]
WantedBy=timers.target
