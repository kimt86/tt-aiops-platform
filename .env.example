# Copy to .env and adjust. The API and extractor read DATABASE_URL.
# Local dev (peer auth over unix socket, role = OS user tkadmin):
DATABASE_URL=postgresql:///wp_tt

# The extractor (and ONLY the extractor) reaches Oracle via tools/oracle-toolbox/ in this repo
# (found next to the binary). Override the dir, relay host or toolbox URL only if needed:
# SKILL_DIR=/path/with/scripts/remote-toolbox-sql
# TT_TOOLBOX_HOST=aiadmin@100.109.43.18
# TT_TOOLBOX_URL=http://127.0.0.1:35000

# API bind address (optional):
API_ADDR=127.0.0.1:8080
